<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sysevent_in_email_action">
    <sysevent_in_email_action action="INSERT_OR_UPDATE">
        <action>record_action</action>
        <active>true</active>
        <assignment_operator/>
        <condition_script>email.subject.toLowerCase().indexOf("incorrect birthday")&gt;=0</condition_script>
        <description>creates incident when user replies on the email with the birthday congratulations and clicks on Incorrect birthday date link.</description>
        <event_name>email.read</event_name>
        <filter_condition/>
        <from/>
        <name>Incorrect Birthday Incident</name>
        <order>100</order>
        <reply_email/>
        <required_roles/>
        <script><![CDATA[(function runAction( /*GlideRecord*/ current, /*GlideRecord*/ event, /*EmailWrapper*/ email, /*ScopedEmailLogger*/ logger, /*EmailClassifier*/ classifier) {

    //create Incident for follow up with details from the received email
    var incident = new GlideRecord('incident');
    incident.short_description = 'Fix incorrect birthday date';
    incident.description = email.body.comments;
    incident.insert();

})(current, event, email, logger, classifier);]]></script>
